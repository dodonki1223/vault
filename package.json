{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "check:mcp": "node .agents/scripts/check-mcp-auth.mjs",
    "agent:profile": "node .agents/scripts/run-agent-profile.mjs",
    "codex:profile": "node .agents/scripts/run-agent-profile.mjs --agent codex",
    "codex:fetch-light": "node .agents/scripts/run-agent-profile.mjs --agent codex fetch-light",
    "codex:fetch-standard": "node .agents/scripts/run-agent-profile.mjs --agent codex fetch-standard",
    "claude:profile": "node .agents/scripts/run-agent-profile.mjs --agent claude",
    "claude:fetch-light": "node .agents/scripts/run-agent-profile.mjs --agent claude fetch-light",
    "claude:fetch-standard": "node .agents/scripts/run-agent-profile.mjs --agent claude fetch-standard",
    "validate:fetch-skills": "node .agents/scripts/validate-fetch-skills.mjs",
    "notify:slack": "node .agents/scripts/notify-slack.mjs",
    "notify:slack:codex": "node .agents/scripts/notify-slack.mjs --agent codex",
    "notify:slack:claude": "node .agents/scripts/notify-slack.mjs --agent claude",
    "notify:slack:claude-code": "node .agents/scripts/notify-slack.mjs --agent claude",
    "save:commit": "codex exec -C . --sandbox danger-full-access \"vault-git-commit skill を使って、現在の差分を確認し、適切な単位で commit してください。push はしないでください。判断に迷う差分がある場合は commit せずに報告してください。\"",
    "usage:today": "ccusage daily --timezone Asia/Tokyo --since $(date +%F) --until $(date +%F)",
    "usage:daily": "ccusage daily --timezone Asia/Tokyo",
    "usage:weekly": "ccusage daily --timezone Asia/Tokyo --since $(date -v-6d +%F) --until $(date +%F)",
    "usage:session": "ccusage session --timezone Asia/Tokyo",
    "usage:monthly": "ccusage monthly --timezone Asia/Tokyo",
    "usage:today:codex": "ccusage codex daily --timezone Asia/Tokyo --since $(date +%F) --until $(date +%F)",
    "usage:daily:codex": "ccusage codex daily --timezone Asia/Tokyo",
    "usage:weekly:codex": "ccusage codex daily --timezone Asia/Tokyo --since $(date -v-6d +%F) --until $(date +%F)",
    "usage:session:codex": "ccusage codex session --timezone Asia/Tokyo",
    "usage:monthly:codex": "ccusage codex monthly --timezone Asia/Tokyo",
    "usage:today:claude": "ccusage claude daily --timezone Asia/Tokyo --since $(date +%F) --until $(date +%F)",
    "usage:daily:claude": "ccusage claude daily --timezone Asia/Tokyo",
    "usage:weekly:claude": "ccusage claude daily --timezone Asia/Tokyo --since $(date -v-6d +%F) --until $(date +%F)",
    "usage:session:claude": "ccusage claude session --timezone Asia/Tokyo",
    "usage:monthly:claude": "ccusage claude monthly --timezone Asia/Tokyo"
  },
  "devDependencies": {
    "ccusage": "^20.0.14"
  }
}
